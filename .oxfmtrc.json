{
	"$schema": "https://unpkg.com/oxfmt/configuration_schema.json",
	"trailingComma": "all",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 110,
	"semi": true,
	"singleQuote": true,
	"bracketSpacing": true,
	"jsdoc": {
		"capitalizeDescriptions": false
	},
	"sortImports": {
		"groups": [["builtin", "bun"], ["this"], ["external"], ["parent"], ["sibling", "index"]],
		"customGroups": [
			{
				"groupName": "this",
				"elementNamePattern": ["@endfield-noclip/**"]
			},
			{
				"groupName": "bun",
				"elementNamePattern": ["bun", "bun:*"]
			}
		]
	},
	"overrides": [
		{
			"files": ["*.md"],
			"options": { "printWidth": 100, "proseWrap": "always" }
		}
	]
}
